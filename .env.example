# Server
PORT=3000
NODE_ENV=development
CONFIG_PATH=./client-config.json
DATA_DB_PATH=./data/leads.sqlite

# Anthropic (FAQ answering)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Brevo (owner email notifications + monthly recap), via HTTPS API.
# BREVO_API_KEY: create at Brevo -> Settings -> SMTP & API -> API Keys.
#   NOTIFY_FROM_EMAIL must be a verified sender in Brevo
#   (Settings -> Senders, Domains & Dedicated IPs -> Senders -> Add sender).
BREVO_API_KEY=
NOTIFY_FROM_EMAIL=leads@yourdomain.com

# Twilio (visitor SMS confirmation)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional but recommended for US A2P 10DLC: send via the Messaging Service
# that is linked to your approved campaign. When set, it is used instead of
# TWILIO_FROM_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=
